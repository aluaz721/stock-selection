# Copy to .env and fill in real values. Never commit .env itself
# (already in .gitignore).

# Financial Modeling Prep API key -- needed only for
# app/data/refresh_fundamentals.py (live data refresh). Not needed for
# backtesting/training against the bundled historical data.
# Get one free (no credit card) at https://financialmodelingprep.com/
FMP_API_KEY=your_fmp_api_key_here

# MLflow tracking URI. Unset -> local sqlite file (app/config/settings.py's
# default). Set to a Postgres URI once Phase 5's docker-compose is up.
# MLFLOW_TRACKING_URI=
